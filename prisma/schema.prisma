generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["interactiveTransactions"]
  binaryTargets   = ["linux-musl", "windows", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int    @id // ID original del usuario (no autoincremental)
  name      String
  username  String @unique
  email     String @unique
  phone     String?
  website   String?
  address   Json?
  company   Json?

  @@map("users")
}